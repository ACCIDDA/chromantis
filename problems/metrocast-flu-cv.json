{
  "schema_version": 1,
  "id": "metrocast-flu-cv",
  "dataset": "../datasets/metrocast-flu.json",
  "panel": "data/metrocast/panel.npz",
  "locations": "data/metrocast/locations.csv",
  "targets": ["metrocast_flu_proportion"],
  "forecast": {"horizons": [1, 2, 3, 4]},
  "folds": {
    "kind": "leave_one_season_out",
