    "training_ids": ["2022-2023", "2023-2024", "2024-2025", "2025-2026"]
  },
  "evaluation": {
    "kind": "weekly_quantile_wis", "inputs": "finalized", "draws": 1,
    "primary": {"target": "metrocast_flu_proportion", "scale": "natural", "geography": "locations"}
  },
  "comparison": {"kind": "none"}
}
