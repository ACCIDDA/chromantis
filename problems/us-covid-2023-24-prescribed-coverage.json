{
  "schema_version": 1,
  "id": "us-covid-2023-24-prescribed-coverage",
  "dataset": "../datasets/respiratory-us-weekly-coverage-cr.json",
  "panel": "data/processed/panel-coverage.npz",
  "locations": "data/metadata/locations.csv",
  "targets": [
    "nhsn_covid_admissions",
    "nssp_covid_proportion"
  ],
  "forecast": {
    "horizons": [
      1,
      2,
      3,
      4
    ]
  },
  "folds": {
    "kind": "leave_one_season_out",
    "ids": [
      "2023-2024"
    ],
    "training_ids": [
      "2022-2023",
      "2023-2024",
      "2024-2025",
      "2025-2026"
    ]
  },
  "evaluation": {
    "kind": "weekly_quantile_wis",
    "inputs": "prescribed",
    "draws": 3,
    "covariate_errors": true,
    "primary": {
      "target": "nhsn_covid_admissions",
      "scale": "log",
      "geography": "states_dc"
    }
  },
  "comparison": {
    "kind": "hub",
    "hub": "covid"
  }
}
